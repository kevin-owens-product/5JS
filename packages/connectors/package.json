{
  "name": "relametric-connectors",
  "version": "0.1.0-alpha.3",
  "description": "Typed data adapters and a server operation gateway for Relametric visualizations",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin-owens-product/Relametric.git",
    "directory": "packages/connectors"
  },
  "homepage": "https://kevin-owens-product.github.io/Relametric/connectors/",
  "bugs": {
    "url": "https://github.com/kevin-owens-product/Relametric/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Kevin Owens",
  "keywords": [
    "relametric",
    "data",
    "connectors",
    "typescript",
    "analytics"
  ]
}
